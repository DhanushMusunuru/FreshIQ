__pycache__/
*.pyc
.venv/
.installed
.cache/

# Runtime inspection output — never part of the app.
python/data/inspections/*/
python/data/inspections.jsonl

# CAD bridge output (regenerated by cad/bridge.py from Fusion)
cad/out/

# Training images. The dataset is large and licensed separately; the trained
# model in python/models/ is what the device actually needs and IS committed.
dataset/**/*.jpg
dataset/**/*.jpeg
dataset/**/*.png

# Large training artifacts. python/models/freshiq_model.tflite is deliberately
# NOT ignored - a clone must be able to run on the board without a second
# download, and it is only ~2.6 MB.
*.keras
*.h5

# OS junk
.DS_Store
Thumbs.db
desktop.ini

# Rendered explainer clips and the packed print bundle live on disk but do not
# belong in the repo - they are build outputs, and the demo video is submitted
# as a link rather than a file.
cad/video/
cad/*.zip

# The float export is not what the device loads - config points at
# freshiq_model.tflite. Shipping both invites deploying the wrong one, which
# fails silently rather than loudly. It stays on disk, out of the repo.
python/models/freshiq_model_float.tflite
